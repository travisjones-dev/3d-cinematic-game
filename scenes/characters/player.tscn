[ext_resource type="PackedScene" path="res://assets/models/warrior.gltf" id="2_warrior"]

[sub_resource type="CapsuleShape3D" id="Col"]
radius = 0.4
height = 2.0

[node name="Player" type="CharacterBody3D"]
safe_margin = 0.2
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("Col")

[node name="Model" type="Node3D" parent="."]

; Mounted under Model (not the body) so it inherits the turn-to-face-travel rotation while the
; collision capsule never spins — see player.gd:_face_travel_direction.
;
; The -1.0 on Y is load-bearing: CapsuleShape3D height 2.0 is CENTRED on the CharacterBody3D
; origin, so the player's origin sits 1.0 m above the ground (test_village_boundaries.gd:27
; depends on exactly this). The imported Warrior is feet-pivoted, so without the offset it
; would float 1 m in the air.
[node name="Warrior" parent="Model" instance=ExtResource("2_warrior")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)
