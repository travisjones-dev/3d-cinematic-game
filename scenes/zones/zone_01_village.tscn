; Ground texture: Poly Haven "sparse_grass", CC0. The albedo_color is kept as a TINT rather than
; reset to white — it multiplies the texture, so the olive-sage palette value still pushes the
; ground toward the village's established colour instead of the pack/photo look taking over
; wholesale. Lighter than the original 0.46,0.5,0.36 so the texture is not crushed dark.
; uv1_scale 22 over a 44 m ground = one tile every 2 m, which is about life-size for this texture.
; All three numbers are cheap to change if it reads wrong.
[sub_resource type="StandardMaterial3D" id="GroundMat"]
albedo_color = Color(0.85, 0.9, 0.72, 1)
albedo_texture = ExtResource("11_grassdiff")
normal_enabled = true
normal_texture = ExtResource("12_grassnor")
uv1_scale = Vector3(22, 22, 1)

