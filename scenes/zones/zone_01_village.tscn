[node name="GuardTower" type="StaticBody3D" parent="Geometry"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -14, 4.5, 7)

; Tower art swapped to the pack's Bell_Tower (3.49 x 8.57 x 4.01 at 1.8, against the graybox's
; 3.5 x 9 x 3.5 — near-exact). The graybox Mesh, the leaning CrackedTop, its Roof and the Door
; are all replaced by it; the model carries its own crown, roof and doorway.
;
; ⚠️ THE `Crack` MESH IS DELIBERATELY KEPT. It is not decoration — the writing points at it:
;   dialogue/act1/friend.dtl:17  "He gestures toward the CRACKED TOWER behind you."
;   dialogue/act1/love.dtl:4     "the top of the CRACKED steps"
;   docs/zones/zone_01_home_village.md:17  "cracked, age-worn stone"
; A pristine bell tower would leave the friend gesturing at a building that contradicts his line,
; and the tower is one of the three environmental-storytelling setups. Story is pillar #1, so the
; art improves but the tower must still READ as cracked. If the crack no longer lands visually
; against the new silhouette, the fix is a better crack — not deleting it and quietly editing the
; dialogue to match.
[node name="Mesh" parent="Geometry/GuardTower" instance=ExtResource("19_belltower")]
transform = Transform3D(1.8, 0, 0, 0, 1.8, 0, 0, 0, 1.8, 0, -4.5, 0)

; Depth widened 3.5 -> 4.05 to match the new silhouette. TowerInteract sits at x=-11.9, outside
; the tower's x range (-15.75..-12.25), so the doorway stays reachable.
[node name="Collision" type="CollisionShape3D" parent="Geometry/GuardTower"]
shape = SubResource("TowerShape2")

