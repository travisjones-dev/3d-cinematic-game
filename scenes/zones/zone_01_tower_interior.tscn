[node name="Aeia" type="Area3D" parent="Interactables" unique_id=777063987]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.1418097, 9.9, 0.1561785)
script = ExtResource("1_npc")
timeline = "res://dialogue/act1/love.dtl"
prompt = "Speak with Aeia"

; Aeia as the pack's Cleric. y = -1 puts her feet on the top platform (surface y=8.9) rather
; than a metre above it — the Area3D sits at 9.9, the centre of the old capsule.
;
; Note this node's name and zero offset are load-bearing: test_interaction_alignment exists
; BECAUSE Aeia's Mesh once carried a stray offset that put her visible body outside her own
; trigger, so "standing right in front of her" would not start the conversation. Keep the mesh
; centred on the Area3D and let the Area3D carry the position.
[node name="Mesh" parent="Interactables/Aeia" instance=ExtResource("5_cleric")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1, 0)
script = ExtResource("6_idle")

[node name="Trigger" type="CollisionShape3D" parent="Interactables/Aeia" unique_id=1753897263]
shape = SubResource("AeiaTriggerShape")

[node name="WatchmanTally" type="Area3D" parent="Interactables"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3, 1, 0.2)
script = ExtResource("4_flavor")
prompt = "Examine the scratches in the stone"
flavor_text = "Scratches in the stone, low down where a man would sit with his back to the wall. Rows of five, tallied and crossed, and then a long gouge where the counting stopped."
